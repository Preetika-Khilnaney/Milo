# ---------- PayPal (sandbox) ----------
# Create a sandbox app at https://developer.paypal.com/dashboard/applications/sandbox
# Leave empty to run in "simulated" PayPal mode (UI is labelled).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ---------- AI model (any OpenAI-compatible endpoint) ----------
# Google Gemini (free tier):  https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
# Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
# OpenAI: LLM_BASE_URL=https://api.openai.com/v1         LLM_MODEL=gpt-4o-mini
# Leave LLM_API_KEY empty to use the rule-based offline agent.

# ---------- Chain ----------
# local   = in-process EVM, contracts auto-deployed at startup (no setup)
# sepolia = real testnet PYUSD + your deployed escrow (npm run deploy:sepolia)
CHAIN_MODE=local
SEPOLIA_RPC_URL=
PLATFORM_PRIVATE_KEY=
BUYER_PRIVATE_KEY=
ESCROW_ADDRESS=
PYUSD_ADDRESS=0xCaC524BcA292aaade2DF8A05cC58F0a65B1B3bB9

# ---------- Demo / economics (illustrative assumptions) ----------
PORT=3000
DEMO_STARTING_PYUSD=250
DEMO_IDLE_BALANCE=340
CARD_FUNDING_PCT=0.022
CARD_FUNDING_FIXED=0.10
CROSS_BORDER_PCT=0.015
PYUSD_NETWORK_COST=0.01
DISPUTE_HANDLING_COST=20
CASHBACK_SHARE=0.4
REWARDS_APY=0.037
ESCROW_RISK_THRESHOLD=40
ESCROW_AMOUNT_THRESHOLD=250
